# SE_SHEETSAI Configuration Template
# Copy to .env and fill in your values
#
# تشغيل النظام الكامل من C:\py\se_sheetsai:
#   1. .\scripts\ensure-dirs.ps1
#   2. docker compose -f docker-compose.full-stack.yml up -d
# (ONLYOFFICE_SERVER و BASE_URL يُستخدمان داخل الحاويات تلقائياً)

SECRET_KEY=SE_SHEETS_SECURE_2026
ONLYOFFICE_JWT_SECRET=RPjV7muU0XNWaRhKGDWK9XBhERAItbfI
ONLYOFFICE_SERVER=http://localhost:8082
BASE_URL=http://localhost:5000

# ===== Internal BI Runtime =====
# Engine can be "sqlite" (default) or "postgres"
BI_RUNTIME_ENGINE=sqlite
BI_RUNTIME_DB_PATH=bi_runtime.db
BI_CACHE_TTL=45

# Optional PostgreSQL runtime (when BI_RUNTIME_ENGINE=postgres)
BI_POSTGRES_HOST=localhost
BI_POSTGRES_PORT=5433
BI_POSTGRES_DB=sheetsai_bi
BI_POSTGRES_USER=sheetsai_user
BI_POSTGRES_PASSWORD=strongpassword

# Roles allowed to create/edit/resync BI dashboards (comma-separated)
BI_ALLOWED_ROLES=admin,مدير عام,مدير القسم,تحليل البيانات
