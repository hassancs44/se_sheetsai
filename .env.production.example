# SE_SHEETSAI — Production env template for DigitalOcean
# Copy to .env on the server and set values. Never commit .env.

# ===== Required =====
SECRET_KEY=<generate-strong-random-32-chars>
BASE_URL=https://your-domain.com
ONLYOFFICE_JWT_SECRET=<same-as-onlyoffice-document-server>
ONLYOFFICE_SERVER=https://onlyoffice.your-domain.com

# ===== Database (app uses SQLite in /app/state when using Docker) =====
# DB_PATH and DB_FALLBACK_PATH are set in docker-compose to /app/state/*.db

# ===== BI Runtime (PostgreSQL in production) =====
BI_RUNTIME_ENGINE=postgres
BI_POSTGRES_HOST=postgres
BI_POSTGRES_PORT=5432
BI_POSTGRES_DB=sheetsai_bi
BI_POSTGRES_USER=sheetsai_user
BI_POSTGRES_PASSWORD=<strong-password>

# ===== Optional =====
# WATERMARK_ENABLED=true
# ALLOW_DOWNLOAD=false
# ARCHIVE_DAYS=180
# COMPRESS_DAYS=365
# BI_ALLOWED_ROLES=admin,مدير عام,مدير القسم,تحليل البيانات
